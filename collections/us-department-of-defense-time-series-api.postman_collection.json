      "item": [
        {
          "id": "a2f37c89-70ab-4f37-9502-a4c9d75468fc",
          "name": "Get Time Series Data",
          "request": {
            "name": "Get Time Series Data",
            "description": {
              "content": "Returns time series data for a specified location and parameter. Supports retrieval of streamflow, gage height, reservoir levels, temperature, and other continuous measurements. Results are paginated for large datasets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "office",
                  "value": "<string>",
                  "description": "USACE district office ID (e.g., CWMS, SWT, LRH)"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Time series ID in format Location.Parameter.Type.Interval.Duration.Version"
                },
                {
                  "disabled": false,
                  "key": "begin",
                  "value": "<string>",
                  "description": "Start of the time window (ISO 8601 or milliseconds since epoch)"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End of the time window (ISO 8601 or milliseconds since epoch)"
                },
                {
                  "disabled": false,
                  "key": "datum",
                  "value": "<string>",
                  "description": "Elevation datum for stage data (e.g., NAVD88, NGVD29)"
                },
                {
                  "disabled": false,
                  "key": "unit",
                  "value": "<string>",
                  "description": "Unit of measure for the output (e.g., EN for English, SI for metric)"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "UTC",
                  "description": "Timezone for date/time values in response"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format"
                },
                {
                  "disabled": false,
                  "key": "page-size",
                  "value": "500",
                  "description": "Number of values per page"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<string>",
                  "description": "Page cursor for pagination (from previous response)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
